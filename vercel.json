{
  "buildCommand": "pnpm turbo run build --filter=@rocketbots/web --ui=stream",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/payload",
      "destination": "https://respond-io-fe-bucket.s3.ap-southeast-1.amazonaws.com/candidate-assessments/payload.json"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
