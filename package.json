{
  "name": "rocketbots-flow-assessment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit --project jsconfig.native.json && node scripts/vue-typecheck.cjs --noEmit --project jsconfig.json && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit --project jsconfig.e2e.json",
    "preview": "vite preview",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src tests vite.config.js cucumber.js",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "cucumber-js"
  },
  "dependencies": {
    "@lucide/vue": "1.47.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/vue-query": "5.103.2",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "pinia": "4.0.3",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "vue-sonner": "2.0.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.15",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.1",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.1",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@12.4.2"
}
