{
  "name": "rocketbots-flow-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@rocketbots/web",
    "build": "turbo run build",
    "build:storybook": "turbo run build --filter=@rocketbots/storybook",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test:unit",
    "test:unit:coverage": "turbo run test:unit:coverage",
    "test:e2e": "turbo run test:e2e --filter=@rocketbots/e2e",
    "storybook": "turbo run storybook --filter=@rocketbots/storybook",
    "preview": "turbo run preview --filter=@rocketbots/web",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings apps packages scripts *.js"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@typescript/typescript6": "6.0.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "turbo": "2.11.3",
    "typescript": "7.0.2",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@12.4.2"
}
