{
  "name": "rocketbots-flow-assessment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit --project jsconfig.json",
    "preview": "vite preview",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src tests vite.config.js playwright.config.js",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/vite": "latest",
    "@tanstack/vue-query": "latest",
    "@vee-validate/zod": "latest",
    "@vue-flow/background": "latest",
    "@vue-flow/controls": "latest",
    "@vue-flow/core": "latest",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "latest",
    "pinia": "latest",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "latest",
    "vee-validate": "latest",
    "vue": "latest",
    "vue-router": "latest",
    "vue-sonner": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "^24.6.0",
    "@vitejs/plugin-vue": "latest",
    "@vitest/coverage-v8": "latest",
    "@vue/test-utils": "latest",
    "jsdom": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vitest": "latest",
    "vue-tsc": "^3.1.1"
  },
  "packageManager": "pnpm@12.4.2"
}
