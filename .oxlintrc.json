{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error", "suspicious": "error", "perf": "error" },
  "plugins": ["vue", "import"],
  "rules": {
    "complexity": ["error", 10],
    "max-depth": ["error", 3],
    "max-lines-per-function": ["error", { "max": 60, "skipBlankLines": true, "skipComments": true }]
  },
  "ignorePatterns": [
    "**/dist",
    "**/.types",
    "**/coverage",
    "**/storybook-static",
    "**/playwright-report",
    "**/test-results"
  ],
  "overrides": [
    { "files": ["packages/ui/src/**"], "rules": { "max-lines-per-function": "off" } },
    { "files": ["apps/web/src/main.js"], "rules": { "import/no-unassigned-import": "off" } }
  ]
}
