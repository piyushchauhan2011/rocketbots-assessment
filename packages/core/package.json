{
  "name": "@rocketbots/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./.types/index.d.ts",
      "import": "./src/index.js"
    },
    "./types": {
      "types": "./.types/nodes/types.d.ts",
      "import": "./src/nodes/types.js"
    }
  },
  "scripts": {
    "build": "pnpm typecheck",
    "typecheck": "tsc --build jsconfig.build.json && tsc --noEmit --project jsconfig.test.json",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.1",
    "vitest": "5.0.1"
  }
}
