{
  "extends": "../../jsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": ".types",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@ui/*": ["src/*"] },
    "strict": false
  },
  "include": ["src/**/*.js", "src/**/*.vue"]
}
