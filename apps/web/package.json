{
  "name": "@rocketbots/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --manifest && pnpm bundle:check",
    "bundle:check": "node scripts/check-bundle-budget.js",
    "typecheck": "node ../../scripts/vue-typecheck.cjs --noEmit --project jsconfig.json",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@lucide/vue": "1.47.0",
    "@rocketbots/core": "workspace:*",
    "@rocketbots/ui": "workspace:*",
    "@tanstack/vue-query": "5.103.2",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "neverthrow": "^8.2.0",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.1",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
